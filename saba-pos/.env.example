# ---------------------------------------------------------------------------
# Saba POS — configuration
# ---------------------------------------------------------------------------
# Copy to .env and edit. Every setting has a working default, so a stock
# install needs none of this.
# ---------------------------------------------------------------------------

# --- the basics ------------------------------------------------------------

# Where the server listens. 0.0.0.0 lets tablets on the restaurant's wifi
# reach it; 127.0.0.1 would restrict it to the till itself.
SABA_HOST=0.0.0.0
SABA_PORT=8080

# Where the database and its backups live. Back up this one directory.
SABA_DATA_DIR=data

# The restaurant's own time zone. Business days, reports and the day-end
# close are all worked out in local time, so this matters.
TZ=Asia/Kolkata


# --- first run -------------------------------------------------------------

# The PIN of the first manager account, created on an empty database.
# Leave it blank and the server generates one and prints it to the log, once.
# It is never a fixed default.
SABA_SETUP_PIN=

# Fill a brand-new database with a worked example — a month of trading and a
# room mid-service. For a demonstration or a sales pitch. A restaurant's own
# first day leaves this at 0 and starts clean.
SABA_SEED_DEMO=0


# --- security --------------------------------------------------------------

# Switch on when the app is served over HTTPS, so the session cookie is
# marked Secure. Leaving it on over plain HTTP stops the cookie being set at
# all and nobody can sign in.
SABA_SECURE_COOKIES=0

# Trust X-Forwarded-For. Only switch this on behind a reverse proxy you
# control — otherwise any client can spoof its address and defeat the PIN
# rate limiter.
SABA_TRUST_PROXY=0

# How long a terminal may stay signed in. A full service plus the close.
SABA_SESSION_HOURS=14


# --- housekeeping ----------------------------------------------------------

# error | warn | info | debug
SABA_LOG_LEVEL=info

# Seconds between keep-alives on the live link to each terminal. Lower this
# if a proxy between the till and the tablets drops idle connections.
SABA_HEARTBEAT_SECONDS=25

# How many nightly backups to keep before the oldest is deleted.
SABA_BACKUP_KEEP=14


# --- the cloud copy (optional) ---------------------------------------------
# Saba is local-first and needs none of this. Leave both blank and the sync
# never starts; the restaurant trades exactly the same.
#
# With a Supabase project connected, the till pushes its bills, dockets,
# audit trail and shifts up, and brings back any menu, price, charge or staff
# change made there. See docs/CLOUD-SYNC.md for creating the project and
# running supabase/001_schema.sql.

# https://<your-project-ref>.supabase.co
SABA_SUPABASE_URL=

# The SERVICE ROLE key, from Supabase → Project Settings → API.
#
# It bypasses row-level security by design, which is exactly why it belongs
# here on the till and nowhere else: never in a browser, never in a repo,
# never in a chat message. If it ever leaks, rotate it in Supabase and change
# it here. The anon key will not work — the till would be refused.
SABA_SUPABASE_KEY=

# Minutes between passes. It is a backup, not a live link; ten is plenty.
SABA_SYNC_MINUTES=10
